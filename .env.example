# Copy to .env and edit. Nothing here is committed.

# --- Robot and camera --------------------------------------------------
PANDA_HOSTNAME=192.168.0.1
REALSENSE_SERIAL=

# --- Inference servers -------------------------------------------------
# Host the robot posts frames to. 127.0.0.1 if servers run on the robot PC.
INFERENCE_HOST=127.0.0.1
# Override a server's listening port (see docs/inference_servers.md)
# PORT=4001

# --- Models and data ---------------------------------------------------
# Checkout of haotian-liu/LLaVA providing llava/eval/run_llava.py
LLAVA_REPO=/opt/LLaVA
# Base llava-v1.5-7b weights
LLAVA_BASE=/data/llava/llava-v1.5-7b
# Directory holding the fine-tuned LoRA adapters
CHECKPOINT_DIR=/data/checkpoints
# CNN checkpoint served by serving/serve_cnn_27class.py
MODEL_PATH=checkpoints/cnn_vgg19_27class.pth
# MODEL_TYPE=vgg          # leave unset to auto-detect from the checkpoint
# Dataset root holding error_data.txt and color_images/
BASE_DIR=/data/project

# --- Slack task interface ----------------------------------------------
# Never commit a real token. Starts with xoxb-
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
